{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/compare/**",
              "components/content/**",
              "components/icons/**",
              "components/navigation/**",
              "components/pricing/**",
              "data/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Poppins|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Poppins, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccordionItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:q|a|key|ref|className|style|children)$/]",
        "message": "<AccordionItem> doesn't accept that prop. Declared props: q, a."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|className|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|outline|neutral)$/]",
        "message": "<Badge> tone must be one of 'accent' | 'outline' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|arrow|href|block|split|disabled|onClick|className|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, arrow, href, block, split, disabled, onClick, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|text)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'text'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='arrow'] > Literal[value!=/^(?:up-right|right|down)$/]",
        "message": "<Button> arrow must be one of 'up-right' | 'right' | 'down'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ComparePlan'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|price|featured|key|ref|className|style|children)$/]",
        "message": "<ComparePlan> doesn't accept that prop. Declared props: name, price, featured."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|included|inherit|key|ref|className|style|children)$/]",
        "message": "<FeatureItem> doesn't accept that prop. Declared props: label, included, inherit."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|title|className|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, title, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|bare|size|disabled|onClick|className|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, bare, size, disabled, onClick, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='InlineList'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|className|key|ref|className|style|children)$/]",
        "message": "<InlineList> doesn't accept that prop. Declared props: items, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Language'] > JSXAttribute > JSXIdentifier[name!=/^(?:code|label|disabled|note|key|ref|className|style|children)$/]",
        "message": "<Language> doesn't accept that prop. Declared props: code, label, disabled, note."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|icon|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: label, href, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:amount|prefix|neutral|className|key|ref|className|style|children)$/]",
        "message": "<PriceChip> doesn't accept that prop. Declared props: amount, prefix, neutral, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:amount|currency|term|size|className|key|ref|className|style|children)$/]",
        "message": "<PriceLabel> doesn't accept that prop. Declared props: amount, currency, term, size, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceLabel'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|sm)$/]",
        "message": "<PriceLabel> size must be one of 'lg' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PricingCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|name|description|price|term|launch|pages|features|featured|badge|ctaLabel|ctaHref|onCta|compareHref|state|className|key|ref|className|style|children)$/]",
        "message": "<PricingCard> doesn't accept that prop. Declared props: index, name, description, price, term, launch, pages, features, featured, badge, ctaLabel, ctaHref, onCta, compareHref, state, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='PricingCard'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:hover)$/]",
        "message": "<PricingCard> state must be one of 'hover'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|eyebrow|title|lead|layout|level|className|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: index, eyebrow, title, lead, layout, level, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:split|stacked)$/]",
        "message": "<SectionHeader> layout must be one of 'split' | 'stacked'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:logoSrc|email|phone|address|about|services|technologies|solutions|company|year|className|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: logoSrc, email, phone, address, about, services, technologies, solutions, company, year, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='SolutionCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|name|description|price|href|onClick|state|className|key|ref|className|style|children)$/]",
        "message": "<SolutionCard> doesn't accept that prop. Declared props: index, name, description, price, href, onClick, state, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SolutionCard'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:hover)$/]",
        "message": "<SolutionCard> state must be one of 'hover'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Step'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|title|description|duration|className|key|ref|className|style|children)$/]",
        "message": "<Step> doesn't accept that prop. Declared props: number, title, description, duration, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemeToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:mode|onToggle|className|key|ref|className|style|children)$/]",
        "message": "<ThemeToggle> doesn't accept that prop. Declared props: mode, onToggle, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemeToggle'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<ThemeToggle> mode must be one of 'dark' | 'light'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
